---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact — Graphisme | Rachelle Arts Visuels" description="Un projet de logo, d'identité visuelle ou de support de communication ? Parlons-en.">
  <section class="container" style="max-width: 640px;">
    <h1 class="page-title">Parlons de ton projet</h1>
    <p style="color: var(--color-muted); margin-bottom: 2rem;">
      Logo, identité visuelle, affiche, packaging, suivi graphique régulier —
      décris-moi ton besoin, je reviens vers toi rapidement.
    </p>

    <form
      id="contact-form"
      action="https://api.web3forms.com/submit"
      method="POST"
    >
      <!--
        1. Crée une clé gratuite sur https://web3forms.com (juste un email,
           pas de backend à héberger, fonctionne sur un site 100% statique).
        2. Remplace VOTRE_CLE_WEB3FORMS ci-dessous par la clé reçue par email.
      -->
      <input type="hidden" name="access_key" value="VOTRE_CLE_WEB3FORMS" />
      <input type="hidden" name="subject" value="Nouvelle demande — Graphisme Rachelle Arts Visuels" />
      <input type="checkbox" name="botcheck" style="display:none;" tabindex="-1" autocomplete="off" />

      <div style="margin-bottom: 1.25rem;">
        <label for="name" style="display:block; margin-bottom: 0.3rem; font-weight: 700;">Nom</label>
        <input type="text" id="name" name="name" required
          style="width:100%; padding: 0.7rem; border-radius: 10px; border: 1px solid var(--color-border);" />
      </div>

      <div style="margin-bottom: 1.25rem;">
        <label for="email" style="display:block; margin-bottom: 0.3rem; font-weight: 700;">Email</label>
        <input type="email" id="email" name="email" required
          style="width:100%; padding: 0.7rem; border-radius: 10px; border: 1px solid var(--color-border);" />
      </div>

      <div style="margin-bottom: 1.25rem;">
        <label for="type_projet" style="display:block; margin-bottom: 0.3rem; font-weight: 700;">Type de projet</label>
        <select id="type_projet" name="type_projet"
          style="width:100%; padding: 0.7rem; border-radius: 10px; border: 1px solid var(--color-border);">
          <option value="Identité visuelle / logo">Identité visuelle / logo</option>
          <option value="Affiche / flyer">Affiche / flyer</option>
          <option value="Packaging">Packaging</option>
          <option value="Suivi graphique régulier">Suivi graphique régulier (maintenance)</option>
          <option value="Autre">Autre</option>
        </select>
      </div>

      <div style="margin-bottom: 1.5rem;">
        <label for="message" style="display:block; margin-bottom: 0.3rem; font-weight: 700;">Ton projet en quelques mots</label>
        <textarea id="message" name="message" rows="5" required
          style="width:100%; padding: 0.7rem; border-radius: 10px; border: 1px solid var(--color-border);"></textarea>
      </div>

      <button type="submit" class="btn-pill" style="border:none; cursor:pointer;">
        Envoyer
      </button>

      <p id="form-status" style="margin-top: 1rem; font-weight: 700;"></p>
    </form>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const status = document.getElementById('form-status');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (status) status.textContent = 'Envoi en cours...';

      const formData = new FormData(form);
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' },
        });
        const result = await res.json();
        if (result.success) {
          if (status) status.textContent = 'Message envoyé, merci ! Je reviens vers toi rapidement.';
          form.reset();
        } else {
          if (status) status.textContent = "Un souci est survenu, réessaie ou écris-moi directement par email.";
        }
      } catch {
        if (status) status.textContent = "Un souci est survenu, réessaie ou écris-moi directement par email.";
      }
    });
  </script>
</Layout>
