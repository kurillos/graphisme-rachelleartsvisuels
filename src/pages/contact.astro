---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact — Graphisme | Rachelle Arts Visuels" description="Un projet de logo, d'identité visuelle ou de support de communication ? Parlons-en.">
  <section class="container">
    <div class="contact-dark-theme">
      <div style="text-align:center;">
        <h1 class="page-title">Parlez-moi de votre projet</h1>
      </div>
      <p class="contact-intro" style="text-align:center; max-width: 60ch; margin: 1.5rem auto 2.5rem;">
        Faire-part, logo, identité visuelle, mise en page, site web — décrivez
        votre besoin et obtenez une réponse rapide.<br />
        Vous pouvez aussi écrire directement à
        <a href="mailto:rachelle.artsvisuels@gmail.com" style="color: var(--color-cyan);">rachelle.artsvisuels@gmail.com</a>.
      </p>

      <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" style="max-width: 480px; margin: 0 auto;">
        <!--
          1. Crée une clé gratuite sur https://web3forms.com
          2. Remplace VOTRE_CLE_WEB3FORMS ci-dessous par la clé reçue par email.
        -->
        <input type="hidden" name="access_key" value="VOTRE_CLE_WEB3FORMS" />
        <input type="hidden" name="subject" value="Nouvelle demande — Graphisme Rachelle Arts Visuels" />
        <input type="checkbox" name="botcheck" style="display:none;" tabindex="-1" autocomplete="off" />

        <div class="field">
          <label for="name">Nom :</label>
          <input class="form-control-custom" type="text" id="name" name="name" required />
        </div>

        <div class="field">
          <label for="email">Email :</label>
          <input class="form-control-custom" type="email" id="email" name="email" required />
        </div>

        <div class="field">
          <label for="telephone">Téléphone :</label>
          <input class="form-control-custom" type="tel" id="telephone" name="telephone" />
        </div>

        <div class="field">
          <label for="type_projet">Type de projet :</label>
          <select class="form-control-custom" id="type_projet" name="type_projet">
            <option value="Faire-part">Faire-part</option>
            <option value="Logo & graphisme">Logo & graphisme</option>
            <option value="Mise en page">Mise en page</option>
            <option value="Site web">Site web</option>
            <option value="Autre">Autre</option>
          </select>
        </div>

        <div class="field">
          <label for="message">Message :</label>
          <textarea class="form-control-custom" id="message" name="message" rows="5" required></textarea>
        </div>

        <div style="text-align:center; margin-top: 2rem;">
          <button type="submit" class="btn-envoyez">Envoyez</button>
        </div>

        <p id="form-status" style="margin-top: 1.5rem; font-weight: 700; text-align:center; color: var(--color-cyan);"></p>
      </form>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const status = document.getElementById('form-status');
    const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (status) status.textContent = 'Envoi en cours...';
      if (submitBtn) submitBtn.disabled = true;

      const formData = new FormData(form);
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' },
        });
        const result = await res.json();
        if (result.success) {
          if (status) status.textContent = 'Message envoyé, merci ! Je reviens vers vous rapidement.';
          form.reset();
        } else {
          if (status) status.textContent = "Un souci est survenu, réessayez ou écrivez-moi directement par email.";
        }
      } catch {
        if (status) status.textContent = "Un souci est survenu, réessayez ou écrivez-moi directement par email.";
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  </script>
</Layout>
