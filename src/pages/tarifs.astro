---
import Layout from '../layouts/Layout.astro';

// Structure de base pour les tarifs / packs graphisme.
// Remplace les valeurs, libellés et inclusions par les tiens.
const formules = [
  {
    nom: 'Pack Essentiel',
    prix: '150 €',
    duree: 'Faire-part / support simple',
    inclus: [
      '1 support (faire-part, flyer...)',
      '2 propositions',
      '1 aller-retour de révisions',
      'Fichier prêt à imprimer',
    ],
    miseEnAvant: false,
  },
  {
    nom: 'Identité visuelle',
    prix: '450 €',
    duree: 'À partir de',
    inclus: [
      'Logo (2 propositions + révisions)',
      'Palette de couleurs & typographies',
      'Déclinaisons de base (carte de visite, réseaux sociaux)',
      'Fichiers sources + exports web/print',
      'Contrat avec droits d’utilisation',
    ],
    miseEnAvant: true,
  },
  {
    nom: 'Suivi graphique',
    prix: 'Sur devis',
    duree: 'Formule maintenance',
    inclus: [
      'Nombre de supports/heures par mois à définir',
      'Déclinaisons et mises à jour au fil de l’année',
      'Priorité sur les demandes',
      'Facturation mensuelle ou trimestrielle',
    ],
    miseEnAvant: false,
  },
];
---
<Layout title="Tarifs — Graphisme | Rachelle Arts Visuels" description="Tarifs et formules graphisme : identité visuelle, supports de communication, suivi graphique régulier.">
  <section class="container">
    <h1 class="page-title">Tarifs & formules</h1>
    <p style="max-width: 60ch; color: var(--color-muted);">
      Quelques repères pour se projeter — chaque projet reste discuté et
      ajusté selon tes besoins.
    </p>

    <div class="pricing-grid">
      {formules.map((f) => (
        <div class:list={['card-pricing', { 'card-pricing-featured': f.miseEnAvant }]}>
          {f.miseEnAvant && <span class="pricing-badge">★ Plus demandée</span>}
          <h2 class="pricing-name">{f.nom}</h2>
          <p class="pricing-price">{f.prix}</p>
          <p class="pricing-tagline">{f.duree}</p>
          <ul class="pricing-features">
            {f.inclus.map((item) => (
              <li>
                <span class="pricing-check">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a href="https://rachelleartsvisuels.fr/contact" class="btn-devis">Demander un devis</a>
        </div>
      ))}
    </div>

    <p style="text-align:center; color: var(--color-muted); margin: 2.5rem 0;">
      Un besoin particulier ou un projet sur-mesure hors de ces formules ?
      <a href="/contact" style="color: var(--color-purple); font-weight:bold;">Contactez-moi</a>, on en discute ensemble.
    </p>
  </section>
</Layout>
