---
import Layout from '../layouts/Layout.astro';

// Structure de base pour les tarifs / packs graphisme.
// Remplace les valeurs et libellés par les tiens.
const formules = [
  {
    nom: 'Identité visuelle',
    prix: 'à partir de 450 €',
    description: 'Logo, palette de couleurs, typographies, déclinaisons de base.',
    inclus: [
      'Logo (2 propositions + révisions)',
      'Charte graphique courte (couleurs, polices)',
      'Fichiers sources + exports web/print',
    ],
  },
  {
    nom: 'Pack Communication',
    prix: 'à partir de 250 €',
    description: 'Affiches, flyers, supports ponctuels.',
    inclus: [
      'Jusqu’à 3 supports',
      '1 aller-retour de révisions par support',
      'Formats prêts à imprimer',
    ],
  },
  {
    nom: 'Maintenance graphique',
    prix: 'sur devis',
    description: 'Suivi régulier pour une marque déjà lancée : déclinaisons, mises à jour, nouveaux supports au fil de l’année.',
    inclus: [
      'Nombre d’heures ou de supports par mois à définir',
      'Priorité sur les demandes',
      'Facturation mensuelle ou trimestrielle',
    ],
  },
];
---
<Layout title="Tarifs — Graphisme | Rachelle Arts Visuels" description="Tarifs et formules graphisme : identité visuelle, supports de communication, maintenance graphique.">
  <section class="container">
    <h1 class="page-title">Tarifs & formules</h1>
    <p style="max-width: 60ch; color: var(--color-muted);">
      Quelques repères pour se projeter — chaque projet reste discuté et
      ajusté selon tes besoins. N’hésite pas à me contacter pour un devis
      précis.
    </p>

    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin-top: 2rem;">
      {formules.map((f) => (
        <div style="border: 2px solid var(--color-border); border-radius: 20px; padding: 1.75rem;">
          <h2 style="color: var(--color-purple); font-size: 1.5rem; margin-bottom: 0.25rem;">{f.nom}</h2>
          <p style="font-weight: 700; font-size: 1.4rem; margin: 0 0 0.75rem;">{f.prix}</p>
          <p style="color: var(--color-muted); margin-bottom: 1rem;">{f.description}</p>
          <ul style="padding-left: 1.1rem; color: var(--color-text);">
            {f.inclus.map((item) => <li style="margin-bottom: 0.4rem;">{item}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <div style="text-align:center; margin: 3rem 0;">
      <a href="/contact" class="btn-pill">Demander un devis</a>
    </div>
  </section>
</Layout>
