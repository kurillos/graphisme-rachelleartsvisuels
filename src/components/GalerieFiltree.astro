---
import { getCollection } from 'astro:content';

const creations = (await getCollection('creations')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Catégories générées automatiquement à partir des créations publiées —
// ajouter une nouvelle catégorie (ici ou via Decap CMS) crée un nouveau
// filtre sans toucher au code.
const categories = [...new Set(creations.map((c) => c.data.categorie))];
---

<div x-data={`{ filtre: 'tous' }`}>
  <div class="filters">
    <button
      type="button"
      x-on:click="filtre = 'tous'"
      x-bind:data-active="filtre === 'tous'"
    >
      Tout
    </button>
    {categories.map((cat) => (
      <button
        type="button"
        x-on:click={`filtre = ${JSON.stringify(cat)}`}
        x-bind:data-active={`filtre === ${JSON.stringify(cat)}`}
      >
        {cat}
      </button>
    ))}
  </div>

  <div class="masonry">
    {creations.map((item) => (
      <figure
        class="masonry-item"
        x-bind:data-hidden={`filtre !== 'tous' && filtre !== ${JSON.stringify(item.data.categorie)}`}
      >
        <img
          src={item.data.image}
          alt={item.data.imageAlt}
          loading="lazy"
        />
        <figcaption class="legend">
          <span class="titre">{item.data.titre}</span>
          {item.data.client && <span> — {item.data.client}</span>}
        </figcaption>
      </figure>
    ))}
  </div>
</div>
