---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Graphisme — identité visuelle, logo, affiche, packaging." } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined} />
    <title>{title}</title>
    <!-- Alpine.js pour l'interactivité du filtre, chargé en défer -->
    <script defer src="https://unpkg.com/alpinejs@3.14.0/dist/cdn.min.js"></script>
  </head>
  <body>
    <header class="container">
      <nav style="display:flex; justify-content:space-between; align-items:center; padding: 1.5rem 0; flex-wrap: wrap; gap: 1rem;">
        <a href="/" style="font-family: var(--font-heading); font-size:1.5rem; color: var(--color-purple); text-decoration:none;">
          Rachelle conception Visuelle et Photographie
        </a>
        <div style="display:flex; align-items:center; gap: 1.5rem;">
          <a href="/tarifs" style="font-size:0.95rem; text-decoration:none; color: var(--color-text);">Tarifs</a>
          <a href="/admin" style="font-size:0.95rem; text-decoration:none; color: var(--color-text);">Connexion</a>
          <a href="https://www.rachelleartsvisuels.fr" style="font-size:0.85rem; color: var(--color-muted); text-decoration:none;">
            ← Site photo
          </a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="container" style="padding: 3rem 0; color: var(--color-muted); font-size: 0.85rem;">
      © {new Date().getFullYear()} Rachelle — Arts Visuels
    </footer>
  </body>
</html>
